<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed: a locally-signed app needs keychain access for Firebase
	     Auth, which the sandbox only grants with an Apple-issued team
	     entitlement. Re-add com.apple.security.app-sandbox (plus
	     keychain-access-groups) if you later sign with a real Apple ID. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
